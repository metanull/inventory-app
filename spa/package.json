{
  "name": "inventory-app-spa",
  "version": "6.0.13",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "test": "vitest run --exclude='**/*.integration.test.ts' --reporter=dot",
    "test:unit": "vitest run --exclude='**/*.integration.test.ts' --reporter=dot",
    "test:unit:watch": "vitest --exclude='**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=dot",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage --exclude='**/*.integration.test.ts' --reporter=dot",
    "test:watch": "vitest --exclude='**/*.integration.test.ts'",
    "test:ui": "vitest --ui --exclude='**/*.integration.test.ts'",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/ --log-level warn",
    "format:check": "prettier --check src/",
    "type-check": "vue-tsc --noEmit",
    "quality-check": "npm run type-check && npm run lint:check && npm run format:check && npm run test"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@metanull/inventory-app-api-client": "1.0.1-dev.1210.2216",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.6.2"
  },
  "overrides": {
    "glob": "^11.1.0",
    "flatted": "^3.4.2",
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    }
  }
}
