# Legacy MWNF database (read-only).
#
# Same variable names the importer uses, so you can copy scripts/importer/.env
# verbatim. This tool NEVER writes: it issues SELECT statements only, and it
# never touches the inventory database at all.
#
# Reaching the live legacy server usually requires the VPN to be up.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=mwnf_ro
LEGACY_DB_PASSWORD=
LEGACY_DB_DATABASE=mwnf3
